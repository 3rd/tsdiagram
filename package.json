{
  "name": "tsdiagram-workspace",
  "version": "0.1.0",
  "repository": "https://github.com/3rd/tsdiagram",
  "description": "Create diagrams and plan your code with TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tsdiagram/web dev",
    "build": "pnpm typecheck && pnpm -r --filter \"!@tsdiagram/renderer\" --workspace-concurrency=1 --if-present run build",
    "preview": "pnpm --filter @tsdiagram/web preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "coverage": "vitest run --coverage",
    "pack:cli": "pnpm --dir packages/cli pack --pack-destination ../../dist",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{json,js,ts,jsx,tsx,html}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@jspm/core": "^2.1.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "web-worker": "1.5.0",
    "process": "^0.11.10",
    "source-map-js": "^1.2.1"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0"
    }
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
